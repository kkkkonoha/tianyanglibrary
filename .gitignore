# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
.env

# database
*.db
*.db-journal

# uploads
/uploads
public/uploads/covers/*
public/uploads/files/*
public/uploads/avatars/*
!public/uploads/covers/.gitkeep
!public/uploads/files/.gitkeep
!public/uploads/avatars/.gitkeep

# generated
/src/generated/prisma
skills-lock.json
.claude/
.windsurf/
.agents/

# build artifacts
*.tsbuildinfo
backups/

# 内部运维文件（含服务器连接信息，不进仓库）
/AGENTS.md
/deploy.ps1
/deploy.sh
/backup-local.ps1

# 本地下载的 APK 构建产物（不入库）
/tianyang-library-apk*
