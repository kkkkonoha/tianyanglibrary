generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ResourceType {
  BOOK
  COMIC
}

enum ActivityType {
  UPLOAD
  RECOMMEND
  CREATE_COLLECTION
  ADD_TO_COLLECTION
  COMMENT
  FAVORITE
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  username         String               @unique
  passwordHash     String
  avatar           String?
  bio              String?
  role             String               @default("user")
  status           String               @default("pending")
  lastUsernameChangeAt DateTime?
  securityQuestion String?
  securityAnswer   String?
  roleHidden       Boolean              @default(false)
  feedbacks        Feedback[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  resources        Resource[]
  collections      Collection[]
  comments         Comment[]
  recommendations  Recommendation[]
  favorites        FavoriteCollection[]
  favoriteResources FavoriteResource[]
  activities       Activity[]
  notifications    Notification[]
  readingHistory   ReadingHistory[]
}

model Resource {
  id              Int                @id @default(autoincrement())
  title           String
  author          String?
  description     String?
  coverImage      String?
  type            ResourceType       @default(BOOK)
  comicSourceId   String?
  comicMangaId    String?
  uploaderId      String
  uploader        User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  tags            ResourceTag[]
  comments        Comment[]
  recommendations Recommendation[]
  collections     CollectionResource[]
  activities      Activity[]
  files           ResourceFile[]
  bindings        ComicBinding[]
  favorites       FavoriteResource[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// 用户收藏的资源（书架/追更）
model FavoriteResource {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([resourceId])
}

// 用户反馈（Bug / 功能需求），管理侧状态流转 + 回复
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  content   String
  status    String   @default("pending")
  reply     String?
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// 漫画条目与 (sourceId, mangaId) 的绑定：跨源同名合并后一条目挂多个源，阅读时可在各源间切换
model ComicBinding {
  id         String   @id @default(cuid())
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sourceId   String
  mangaId    String
  createdAt  DateTime @default(now())

  @@unique([sourceId, mangaId])
  @@index([resourceId])
}

model ResourceFile {
  id         String   @id @default(cuid())
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileSize   Int      @default(0)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  resources ResourceTag[]
}

model ResourceTag {
  resourceId Int
  tagId      String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([resourceId, tagId])
}

model Collection {
  id          String               @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  isPublic    Boolean              @default(true)
  creatorId   String
  creator     User                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  resources   CollectionResource[]
  comments    Comment[]
  favorites   FavoriteCollection[]
  activities  Activity[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model CollectionResource {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resourceId   Int
  resource     Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  note         String?
  addedAt      DateTime   @default(now())
  @@unique([collectionId, resourceId])
}

model Comment {
  id           String      @id @default(cuid())
  content      String
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId   Int?
  resource     Resource?   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Comment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      Comment[]   @relation("CommentReplies")
  createdAt    DateTime    @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  content    String
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Recommendation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime @default(now())
  @@unique([userId, resourceId])
}

model FavoriteCollection {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  @@unique([userId, collectionId])
}

model Activity {
  id           String       @id @default(cuid())
  type         ActivityType
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId   Int?
  resource     Resource?    @relation(fields: [resourceId], references: [id])
  collectionId String?
  collection   Collection?  @relation(fields: [collectionId], references: [id])
  metadata     String?
  createdAt    DateTime     @default(now())
}

model ReadingHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mangaId     String
  mangaTitle  String
  chapterId   String
  chapterName String
  pageIndex   Int      @default(0)
  totalPages  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, mangaId])
}
